<%- include('partials/header') %>

<main>
  <section class="organization-detail">
    <div class="organization-header">
      <img
        src="/images/<%= organizationDetails.logo_filename %>"
        alt="<%= organizationDetails.name %> logo"
        class="organization-logo"
      />
      <div>
        <h1><%= organizationDetails.name %></h1>
        <p class="organization-email">
          <strong>Email:</strong>
          <%= organizationDetails.contact_email %>
        </p>
      </div>
    </div>

    <div class="organization-content">
      <h2>About this Organization</h2>
      <p><%= organizationDetails.description %></p>

      <h2>Service Projects</h2>
      <% if (projects && projects.length > 0) { %>
        <ul class="project-list">
          <% projects.forEach(function(project) { %>
            <li class="project-item">
              <a href="/project/<%= project.id %>"><%= project.title %></a>
              <p>
                <%= new Date(project.project_date).toLocaleDateString('en-US', {
                  year: 'numeric', month: 'long', day: 'numeric'
                }) %>
                · <%= project.location %>
              </p>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p>This organization has no service projects yet.</p>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>