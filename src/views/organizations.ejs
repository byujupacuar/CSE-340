<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <section class="organizations">

            <ul class="organization-list">
                <% organizations.forEach(function(organization) { %>
                    <li class="organization-item">
                        <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.logo_filename %> logo"><h2><a href="/organization/<%= organization.id %>"><%= organization.name %></a></h2>
                      
                    </li>
                <% }); %>
     
            </ul>
    </section>
    </main>
<%- include('partials/footer') %>
