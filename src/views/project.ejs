<%- include('partials/header') %>
<main>
  <section class="project-detail">
    <% if (projectDetails) { %>
      <div class="project-header">
        <h1><%= projectDetails.title %></h1>
        <p class="page-actions">
          <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-project/<%= projectDetails.id %>" class="btn-secondary">Edit Project</a>
          <% } %> 
        </p>
      </div>
      <div class="project-content">
        <p><%= projectDetails.description %></p>

        <p>
          <strong>Date:</strong>
          <%= new Date(projectDetails.project_date).toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric'
          }) %>
        </p>

        <p><strong>Location:</strong> <%= projectDetails.location %></p>

        <p>
          <strong>Organization:</strong>
          <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.name %></a>
        </p>

        <% if (isLoggedIn) { %>
          <div class="volunteer-box">
            <% if (isVolunteer) { %>
              <p><strong>You are volunteering for this project.</strong></p>
              <form action="/unvolunteer/<%= projectDetails.id %>" method="POST" class="inline-form">
                <button type="submit" class="link-button">Remove me as a volunteer</button>
              </form>
            <% } else { %>
              <form action="/volunteer/<%= projectDetails.id %>" method="POST" class="inline-form">
                <button type="submit" class="link-button">Volunteer for this project</button>
              </form>
            <% } %>
          </div>
        <% } %>

        <h2>Categories</h2>
        <% if (categories && categories.length > 0) { %>
          <ul class="category-list">
            <% categories.forEach(function(category) { %>
              <li class="category-item">
                <a href="/category/<%= category.id %>"><%= category.name %></a>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p>This project has no categories assigned.</p>
        <% } %>
      </div>
      <% if (user && user.role_name === 'admin') { %>
        <p class="page-actions"><a href="/assign-categories/<%= projectDetails.id %>" class="btn-secondary">Edit Categories</a></p>
      <% } %>
    <% } else { %>
      <p>Project not found.</p>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>