<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <section class="projects">
            <ul class="project-list">
                <%projects.forEach(project => { %>
                    <li class="project-item">
                        <h3><%= project.title %></h3>
                        <p><%= project.description %></p>
                    </li>
                <% }); %>
            </ul>
        </section>
    </main>
<%- include('partials/footer') %>