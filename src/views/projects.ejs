<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <section class="projects">
            <ul class="project-list">
                <%projects.forEach(project => { %>
                    <li class="project-item">
                        <a href="/project/<%= project.id %>"><%= project.title %></a>
                        <p>(<a href="/organization/<%= project.organization_id %>"><%= project.name %></a>)</p>
                                         
                    </li>
                <% }); %>
            </ul>
        </section>
        <p class="page-actions"><a href="/new-project" class="btn-primary">+ Add a New Service Project</a></p>
    </main>
<%- include('partials/footer') %>