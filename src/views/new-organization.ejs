<%- include('partials/header') %>
<main>
  <section class="form-card">
    <div class="form-header">
      <h1><%= title %></h1>
    </div>

    <form action="/new-organization" method="POST" class="organization-form">
      <div class="form-group">
        <label for="name">Organization Name</label>
        <input
          type="text"
          id="name"
          name="name"
          maxlength="150"
          required
        />
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea
          id="description"
          name="description"
          rows="5"
          maxlength="500"
          required
        ></textarea>
      </div>

      <div class="form-group">
        <label for="contactEmail">Contact Email</label>
        <input
          type="email"
          id="contactEmail"
          name="contactEmail"
          maxlength="255"
          autocomplete="email"
          required
        />
      </div>

      <button type="submit" class="btn-primary">Create Organization</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
