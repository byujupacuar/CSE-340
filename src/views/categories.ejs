<%- include('partials/header') %>
  <main>
    <h1><%= title %></h1>

    <section class="categories">
      <ul class="category-list">
        <%categories.forEach(category => { %>
          <li class="category-item"><h3><a href="/category/<%= category.id %>"><%= category.name %></a></h3>
            
          </li>
        <% }); %> 
        
      </ul>
      <% if (user && user.role_name === 'admin') { %>
        <p class="page-actions"><a href="/new-category" class="btn-primary">+ Add a new category</a></p>
      <% } %>
    </section>
  </main>
<%- include('partials/footer') %>