<%- include('partials/header') %>
  <main>
    <h1><%= title %></h1>

    <section class="categories">
      <ul class="category-list">
        <%categories.forEach(category => { %>
          <li class="category-item"><h3><%= category.name %></h3>
          <p><%= category.description %></p>
          </li>
        <% }); %> 
        
      </ul>
    </section>
  </main>
<%- include('partials/footer') %>