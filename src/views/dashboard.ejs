<%- include('partials/header') %>

<main>
  <section class="project-detail">
    <div class="project-header">
      <h1><%= title %></h1>
      <h2>Dashboard</h2>
    </div>

    <div class="project-content">
      <p><strong>Name:</strong> <%= name %></p>
      <p><strong>Email:</strong> <%= email %></p>
    </div>
    <h2>My Volunteer Projects</h2>
      <% if (volunteerProjects && volunteerProjects.length > 0) { %>
        <ul class="project-list">
          <% volunteerProjects.forEach(function(project) { %>
            <li class="project-item">
              <a href="/project/<%= project.id %>"><%= project.title %></a>
              <p>
                <%= new Date(project.project_date).toLocaleDateString('en-US', {
                  year: 'numeric', month: 'long', day: 'numeric'
                }) %>
                · <%= project.location %> · <%= project.organization_name %>
              </p>
              <form action="/unvolunteer/<%= project.id %>" method="POST" class="inline-form">
                <input type="hidden" name="returnTo" value="dashboard" />
                <button type="submit" class="link-button">Remove me as a volunteer</button>
              </form>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p>You haven't signed up to volunteer for any projects yet.</p>
      <% } %>

    <div>
      <p><strong>Role:</strong> <%= role_name %></p>

      <% if (role_name === 'admin') { %>
        <p class="page-actions"><a href="/users" class="btn-secondary">View All Users</a></p>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>